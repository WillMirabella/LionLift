# Copy this file to .env and fill in the values, .env is gitignored so it never gets committed
#   cp .env.example .env
# flask run loads .env automatically (needs python-dotenv from requirements.txt)
#
# Leave these as the placeholders to skip Gmail, codes will be printed in the flask terminal instead

# Team Gmail account the verification codes are sent from
GMAIL_ADDRESS=your-team-address@gmail.com

# App password for that account (NOT its normal password)
# Turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-character-app-password
